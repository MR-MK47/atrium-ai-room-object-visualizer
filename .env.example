# AI_PROVIDER: Switch active AI provider ("cloudflare" or "gemini")
AI_PROVIDER="cloudflare"

# Direct multi-image editing model (default: @cf/black-forest-labs/flux-2-klein-4b)
CF_IMAGE_MODEL="@cf/black-forest-labs/flux-2-klein-4b"
AI_MODEL="@cf/black-forest-labs/flux-2-klein-4b"

# GEMINI_API_KEY: Optional if using Gemini provider
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model overrides:
#   - Cloudflare Workers AI: @cf/black-forest-labs/flux-2-klein-4b, @cf/black-forest-labs/flux-1-schnell
#   - Gemini: gemini-nano-banana-2.1, gemini-3.1-flash-lite-image
GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"
CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-2-klein-4b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Default upload and asset retention guardrails (customizable live in the Settings panel)
MAX_UPLOAD_MB="10"
GENERATION_TIMEOUT_MS="45000"
ASSET_RETENTION_HOURS="24"

# Optional Cloudflare Turnstile secret key for production bot protection
TURNSTILE_SECRET_KEY=""

# Cloudflare Workers AI credentials for Flux-1 Schnell image generation
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
